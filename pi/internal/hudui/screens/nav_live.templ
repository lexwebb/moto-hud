package screens

import (
	"moto-hud/pi/internal/hudui/scene"
	"moto-hud/pi/internal/hudui/scenetempl"
)

// NavLiveBody is live nav: left ribbon/minimap column and right stacked distance/road/ETA.
templ NavLiveBody(leftCol, lanes templ.Component, dist string, distBaseline, mw, rightX int, roadLines []string, roadBaselines []int, eta string, etaBaseline int, showEta bool) {
	@leftCol
	@scenetempl.Text("distance", scene.Face16x32, mw, distBaseline, "end", dist)
	for i, ln := range roadLines {
		@scenetempl.Text("road", scene.Face8x16, rightX, roadBaselines[i], "start", ln)
	}
	if showEta {
		@scenetempl.Text("eta", scene.Face8x16, rightX, etaBaseline, "start", eta)
	}
	@lanes
}
