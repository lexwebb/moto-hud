package screens

import (
	"moto-hud/pi/internal/hudui/scene"
	"moto-hud/pi/internal/hudui/scenetempl"
)

// ChromeFrameBody is the shared HUD frame: header rule, legend column, mode, and main column slot.
// BLE link is drawn via plan layer ble_link (empty link group placeholder).
templ ChromeFrameBody(mode, legPrev, legAction, legNext string, pad, divY, ruleX, headerBaseline, legTop, legMid, legBot, linkX, linkY, canvasW, canvasH int, main templ.Component) {
	@scenetempl.Line(pad, divY, ruleX, divY)
	@scenetempl.Line(ruleX, pad, ruleX, canvasH-pad)
	@scenetempl.Group("main", pad, 0) {
		@scenetempl.Text("mode", scene.Face6x12, 0, headerBaseline, "start", mode)
		@scenetempl.EmptyGroup("link", linkX, linkY)
		@main
	}
	@scenetempl.Text("leg_prev", scene.Face6x12, canvasW-pad, legTop, "end", legPrev)
	@scenetempl.Text("leg_action", scene.Face6x12, canvasW-pad, legMid, "end", legAction)
	@scenetempl.Text("leg_next", scene.Face6x12, canvasW-pad, legBot, "end", legNext)
}
