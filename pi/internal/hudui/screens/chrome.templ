package screens

import "strconv"

// ChromeShell is the shared HUD frame: header rule, legend column, mode/link, and main column slot.
templ ChromeShell(mode, legPrev, legAction, legNext string, pad, mw, divY, ruleX, headerBaseline, legTop, legMid, legBot, linkX, linkY, canvasW, canvasH int, linkSVG, content string) {
	<line x1={ strconv.Itoa(pad) } y1={ strconv.Itoa(divY) } x2={ strconv.Itoa(ruleX) } y2={ strconv.Itoa(divY) } stroke="#000" stroke-width="1"></line>
	<line x1={ strconv.Itoa(ruleX) } y1={ strconv.Itoa(pad) } x2={ strconv.Itoa(ruleX) } y2={ strconv.Itoa(canvasH - pad) } stroke="#000" stroke-width="1"></line>
	<g id="main" transform={ "translate(" + strconv.Itoa(pad) + ",0)" }>
		<text id="mode" data-pixel="6x12" x="0" y={ strconv.Itoa(headerBaseline) } font-size="12" fill="#000">{ mode }</text>
		<g id="link" transform={ "translate(" + strconv.Itoa(linkX) + "," + strconv.Itoa(linkY) + ")" }>
			@templ.Raw(linkSVG)
		</g>
		@templ.Raw(content)
	</g>
	<text id="leg_prev" data-pixel="6x12" x={ strconv.Itoa(canvasW - pad) } y={ strconv.Itoa(legTop) } text-anchor="end" font-size="12" fill="#000">{ legPrev }</text>
	<text id="leg_action" data-pixel="6x12" x={ strconv.Itoa(canvasW - pad) } y={ strconv.Itoa(legMid) } text-anchor="end" font-size="12" fill="#000">{ legAction }</text>
	<text id="leg_next" data-pixel="6x12" x={ strconv.Itoa(canvasW - pad) } y={ strconv.Itoa(legBot) } text-anchor="end" font-size="12" fill="#000">{ legNext }</text>
}
