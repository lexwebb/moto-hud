# syntax=docker/dockerfile:1
# Build motohud for Raspberry Pi Zero / Zero W (linux/arm/v6).
#
# BLE needs CGO + BlueZ against a Pi-compatible armv6 hard-float userspace.
# We compile inside balenalib's raspberry-pi image via buildx/QEMU.
#
#   ./scripts/build-armv6.sh
#   ./scripts/build-armv6.sh --ble
#
# Output artifact: motohud-linux-armv6

ARG GO_VERSION=1.25.0

FROM balenalib/raspberry-pi-debian:bookworm-build AS build
ARG GO_VERSION
ARG BLE=0

# QEMU user-mode often breaks apt GPG ("invalid signature"). Trust the
# Raspbian mirrors for this hermetic build only. Keep the layer lean: the
# -build image is already large and BuildKit's default rootfs is tight.
RUN set -eux; \
    find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -print0 \
      | xargs -0 -r sed -i \
          -e 's/^deb /deb [trusted=yes] /' \
          -e 's/^deb-src /deb-src [trusted=yes] /'; \
    rm -rf /var/cache/apt/archives/* /var/lib/apt/lists/*; \
    apt-get update; \
    apt-get install -y --no-install-recommends --no-upgrade \
      libbluetooth-dev; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-armv6l.tar.gz" \
      | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}" \
    GOTOOLCHAIN=local \
    GOPATH=/go \
    GOCACHE=/root/.cache/go-build \
    CGO_ENABLED=1

WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . ./

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /out \
    && if [ "$BLE" = "1" ]; then \
         go build -tags ble -ldflags='-s -w' -o /out/motohud ./cmd/motohud; \
       else \
         CGO_ENABLED=0 go build -ldflags='-s -w' -o /out/motohud ./cmd/motohud; \
       fi \
    && test -x /out/motohud && ls -lh /out/motohud

FROM scratch AS export
COPY --from=build /out/motohud /motohud-linux-armv6
