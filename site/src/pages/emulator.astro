---
import BaseLayout from '../layouts/BaseLayout.astro';
import 'leaflet/dist/leaflet.css';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Emulator" description="Leaflet ride simulator with Go WASM HUD" fullBleed>
  <div class="emu">
    <section class="panel">
      <h1>Route map</h1>
      <p class="meta">Leaflet + OSM · fake ride feeds the HUD over the same nav protocol</p>
      <div id="map"></div>
      <p class="meta" style="margin-top:.75rem">© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a></p>
    </section>

    <section class="panel">
      <h1>HUD</h1>
      <p class="meta" id="backendMeta">Loading WASM backend (~15MB)…</p>
      <div class="bezel" data-device="waveshare">
        <div class="screen" data-device="waveshare"><canvas id="hud" width="250" height="122" aria-label="HUD"></canvas></div>
      </div>
      <div class="device-row">
        <label for="deviceSelect">Device</label>
        <select id="deviceSelect" aria-label="Emulated display device"></select>
        <span class="hint" id="deviceHint">—</span>
      </div>
      <div class="row">
        <button type="button" id="play" class="primary">Play route</button>
        <button type="button" id="pause">Pause</button>
        <button type="button" id="reset">Reset</button>
      </div>
      <div class="timeline" id="timeline">
        <div class="timeline-meta">
          <span id="timelinePos">0 m</span>
          <span id="timelineTime">0:00 / —</span>
        </div>
        <div class="timeline-track">
          <input
            type="range"
            id="scrub"
            min="0"
            max="1000"
            value="0"
            step="1"
            aria-label="Scrub along route"
          />
          <div class="timeline-marks" id="timelineMarks" hidden></div>
        </div>
        <div class="timeline-turns" id="timelineTurns"></div>
      </div>
      <div class="row">
        <button type="button" data-btn="prev">Prev</button>
        <button type="button" data-btn="action">Action</button>
        <button type="button" data-btn="next">Next</button>
      </div>
      <div class="row">
        <button type="button" data-btn="prev_long">Prev long</button>
        <button type="button" data-btn="action_long">Home (long)</button>
        <button type="button" data-btn="next_long">Next long</button>
      </div>
      <div class="stat" id="stats">—</div>
      <p class="meta" style="margin-top:1rem">
        First load downloads ~15MB WASM. For local Go HTTP preview use <code>./scripts/emu.sh</code>.
        Junction rendering: <a href={`${base}minimap-lab/`}>minimap lab</a>
        · <a href={`${base}junction-lab/`}>junction IR stubs</a>.
      </p>
    </section>
  </div>
</BaseLayout>

<script is:inline define:vars={{ base }}>
  window.__MOTO_HUD_BASE__ = base;
</script>
<script is:inline src="/moto-hud/emulator/wasm_exec.js"></script>
<script>
  import '../scripts/emulator.js';
</script>

<style>
  .emu {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 1.25rem;
    padding: 1.25rem;
    min-height: calc(100vh - 3.2rem);
  }
  .emu h1 { margin: 0 0 .25rem; font-size: 1.35rem; }
  .emu .meta { color: var(--muted); font-size: .9rem; margin: 0 0 1rem; }
  .emu .panel {
    background: var(--panel);
    border-radius: 4px;
    padding: 1rem;
    min-height: 0;
  }
  #map { height: min(70vh, 560px); border-radius: 3px; background: #111; }
  .bezel {
    background: #0d0e10;
    padding: 1rem;
    width: fit-content;
    border-radius: 3px;
    margin: 0 auto 1rem;
  }
  .screen {
    width: 500px;
    height: 244px;
    background: #fff;
    overflow: hidden;
  }
  .screen canvas {
    width: 250px;
    height: 122px;
    display: block;
    transform: scale(2);
    transform-origin: top left;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
  .screen[data-device="lcd"] {
    width: 500px;
    height: calc(500px * 240 / 320);
    background: #0a0c10;
  }
  .screen[data-device="lcd"] canvas {
    width: 320px;
    height: 240px;
    transform: scale(calc(500 / 320));
  }
  .bezel[data-device="inky"] {
    background: #121014;
    box-shadow: inset 0 0 0 1px #5a3040;
  }
  .bezel[data-device="lcd"] {
    background: #151820;
    box-shadow: inset 0 0 0 1px #3a4250;
  }
  .row { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: .75rem; }
  .emu button {
    flex: 1;
    min-width: 5rem;
    padding: .55rem .7rem;
    border: 1px solid #555;
    border-radius: 3px;
    background: #1e2124;
    color: var(--text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .emu button.primary { background: var(--accent); color: #1a1c1e; border: none; }
  .emu button:disabled { opacity: .45; cursor: wait; }
  .timeline {
    margin-top: .85rem;
    padding: .7rem .75rem .65rem;
    background: #1e2124;
    border: 1px solid #3a3f44;
    border-radius: 3px;
  }
  .timeline-meta {
    display: flex;
    justify-content: space-between;
    gap: .75rem;
    font-family: ui-monospace, monospace;
    font-size: .78rem;
    color: var(--muted);
    margin-bottom: .45rem;
  }
  .timeline-track { position: relative; padding: .35rem 0 .55rem; }
  .timeline-track input[type="range"] {
    width: 100%;
    margin: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .timeline-marks {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: .2rem;
    pointer-events: none;
  }
  .timeline-marks span {
    position: absolute;
    top: 0;
    width: 2px;
    height: 100%;
    background: #c4a35a;
    opacity: .55;
    transform: translateX(-50%);
  }
  .timeline-turns {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    margin-top: .35rem;
  }
  .timeline-turns button {
    flex: 0 1 auto;
    min-width: 0;
    padding: .3rem .5rem;
    font-size: .72rem;
    font-weight: 600;
    border-color: #4a5056;
    background: #16191b;
  }
  .timeline-turns button.active {
    border-color: var(--accent);
    color: var(--accent);
  }
  .stat {
    font-family: ui-monospace, monospace;
    font-size: .8rem;
    color: var(--muted);
    margin-top: .75rem;
    line-height: 1.5;
    white-space: pre-wrap;
  }
  .device-row {
    display: flex;
    align-items: center;
    gap: .75rem;
    flex-wrap: wrap;
    margin-top: .85rem;
    padding: .65rem .75rem;
    background: #1e2124;
    border: 1px solid #3a3f44;
    border-radius: 3px;
    font-size: .9rem;
  }
  .device-row label {
    font-weight: 600;
    user-select: none;
  }
  .device-row select {
    font: inherit;
    font-weight: 600;
    padding: .35rem .5rem;
    border-radius: 3px;
    border: 1px solid #555;
    background: #16191b;
    color: var(--text);
    min-width: 12rem;
  }
  .device-row .hint { color: var(--muted); font-weight: 400; font-size: .8rem; flex: 1 1 12rem; }
  .screen.wiping { outline: 1px solid var(--accent); }
  @media (max-width: 960px) {
    .emu { grid-template-columns: 1fr; }
    .screen { width: 100%; max-width: 500px; height: auto; aspect-ratio: 250 / 122; }
    .screen canvas { width: 100%; height: auto; transform: none; }
    .screen[data-device="lcd"] { aspect-ratio: 320 / 240; }
  }
</style>
